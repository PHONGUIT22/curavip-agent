# ==============================================================================
# CURAVIP - ENVIRONMENT CONFIGURATION (QLOO AGENTIC HACKATHON 2026)
# ==============================================================================
# 1. Qloo Cultural AI API (Mandatory for Live Grounding)
# Get key via form: https://forms.gle/zz12orkLHTAneLGz6
QLOO_API_KEY=your_qloo_api_key_here
# BASE URL: MUST be hackathon.api.qloo.com (api.qloo.com will return 401 on hackathon tier)
QLOO_API_URL=https://hackathon.api.qloo.com
QLOO_TIMEOUT_MS=8000
# 2. Universal LLM Engine (Gemini 3.8 Flash Primary + AWS Bedrock Fallback)
# Option A: Google Gemini 3.8 Flash (Primary Engine via @google/genai SDK)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ID=gemini-3.8-flash
# Option B: AWS Bedrock Claude (Enterprise Engine / Fallback)
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=au.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_TIMEOUT_MS=45000
# AWS_SESSION_TOKEN=
# Option C: OpenAI (Alternative Fallback)
OPENAI_API_KEY=
# 3. AWS Polly Neural Voice Synthesis (Executive Concierge Audio)
POLLY_VOICE_ID=Ruth
# 4. Networking & Ports
PORT=3001
MCP_PORT=3001
NEXT_PUBLIC_MCP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001